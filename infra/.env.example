# =============================================================================
# Modèle de configuration — infrastructure GLPI sécurisée
# -----------------------------------------------------------------------------
# CDC §3.5 : aucun secret en dur dans le code ni dans le dépôt versionné.
# Copier ce fichier en « .env » sur la machine cible, le remplir, puis :
#     chmod 600 .env && chown root:root .env
# Le fichier « .env » est exclu du dépôt par .gitignore. Ne jamais le committer.
# Aucune valeur ci-dessous n'est une valeur réelle : ce sont des exemples.
# =============================================================================

# --- Identité et réseau ------------------------------------------------------
GLPI_FQDN=glpi.lab.local
SRV_LAN_IP=192.168.56.10
CLI_LAN_IP=192.168.56.20
LAN_CIDR=192.168.56.0/24
VPN_SUBNET=10.8.0.0
VPN_MASK=255.255.255.0
VPN_CIDR=10.8.0.0/24
VPN_SRV_IP=10.8.0.1
VPN_PORT=1194
VPN_PROTO=udp
SSH_PORT=22

# --- Base de données ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=glpidb
DB_USER=glpiuser
# Générer avec : openssl rand -base64 32
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
# Utilisé uniquement par le script de sécurisation initiale de MariaDB
DB_ROOT_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# --- GLPI --------------------------------------------------------------------
GLPI_VERSION=10.0.20
# Empreinte SHA-256 de l'archive, relevée sur la page de publication officielle.
# CDC §3 « défaillances d'intégrité des données » : vérifier avant de décompresser.
GLPI_SHA256=REMPLACER_PAR_LA_SOMME_SHA256_OFFICIELLE
GLPI_CODE_DIR=/var/www/glpi
GLPI_CONFIG_DIR=/etc/glpi
GLPI_VAR_DIR=/var/lib/glpi
GLPI_LOG_DIR=/var/log/glpi

# --- TLS ---------------------------------------------------------------------
# « letsencrypt » si le serveur est joignable depuis Internet, « selfsigned » sinon.
TLS_MODE=selfsigned
TLS_EMAIL=admin@example.invalid

# --- Messagerie (collecteur de tickets et notifications) ---------------------
# Boîte dédiée au lab. CDC §8 : aucune donnée réelle de personne.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=glpi@example.invalid
SMTP_PASSWORD=REMPLACER
IMAP_HOST=imap.example.invalid
IMAP_PORT=993
IMAP_USER=support@example.invalid
IMAP_PASSWORD=REMPLACER

# --- Sauvegardes -------------------------------------------------------------
BACKUP_DIR=/var/backups/glpi
BACKUP_RETENTION_DAYS=14
# Passphrase de chiffrement des archives (openssl enc -aes-256-cbc)
BACKUP_PASSPHRASE=REMPLACER_PAR_UNE_PASSPHRASE_FORTE

# --- Jeu de données fictif et API GLPI (issue #32) ---------------------------
# Garde-fou : le script de peuplement crée des comptes à mot de passe connu.
# Il refuse de s'exécuter tant que cette variable ne vaut pas « oui ».
# Ne JAMAIS la positionner sur un environnement de production.
LAB_ENVIRONMENT=oui

# API REST de GLPI. À activer dans Configuration > Générale > API,
# puis relever le jeton d'application du client API créé.
GLPI_URL=https://glpi.lab.local/apirest.php
GLPI_APP_TOKEN=REMPLACER_PAR_LE_JETON_D_APPLICATION
# Jeton personnel, dans les préférences de l'utilisateur qui peuple.
GLPI_USER_TOKEN=REMPLACER_PAR_LE_JETON_UTILISATEUR
# Mot de passe commun aux comptes de démonstration.
# Générer avec : openssl rand -base64 18
DEMO_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_DE_DEMONSTRATION

# --- Supervision -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
ALERT_EMAIL=admin@example.invalid
